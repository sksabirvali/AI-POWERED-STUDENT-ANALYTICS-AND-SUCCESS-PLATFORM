# Copy to .env for local development; set the passwords to private values.
DATABASE_URL=sqlite:///./student_success.db
APP_AUTH_SECRET=
APP_SEED_DEMO=true
APP_FRONTEND_DIST=
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure local demo credentials here; Render requests these as private values.
DEMO_ADMIN_PASSWORD=
DEMO_FACULTY_PASSWORD=
DEMO_STUDENT_PASSWORD=
